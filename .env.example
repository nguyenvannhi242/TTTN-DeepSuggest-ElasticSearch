# --- Elasticsearch Configuration ---
# URL Elasticsearch mà các script (chạy trên máy) sẽ kết nối đến
ELASTICSEARCH_HOST=http://localhost:9200
# Tên index trong Elasticsearch
INDEX_NAME=products

# --- Embedding Model Configuration ---
# Tên model Sentence Transformer sẽ sử dụng (cho script embed_to_json.py)
MODEL_NAME=bkai-foundation-models/vietnamese-bi-encoder
# Số chiều của vector embedding (all-MiniLM-L6-v2 là 384, vietnamese-bi-encoder là 768)
VECTOR_DIM=768

# --- File Paths Configuration ---
# Đường dẫn file CSV/Excel đầu vào thô
RAW_CSV_FILE=data/raw_products.xlsx
# Đường dẫn file CSV/Excel đã chuẩn hóa UTF-8 (do preprocess tạo ra)
PREPROCESSED_CSV_FILE=data/raw_products_clean.xlsx
# Đường dẫn file JSON sau khi tiền xử lý (output của preprocess, input của embed)
PREPROCESSED_JSON_FILE=data/mock_products.json
# Đường dẫn file JSON cuối cùng chứa embedding (output của embed, input của import)
EMBEDDED_JSON_FILE=data/mock_products_with_embedding.json
